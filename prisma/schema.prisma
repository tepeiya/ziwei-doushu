// 紫微斗数商业化站点 · 生产数据层（Postgres）
// 由 lib/db/index.ts 使用；字段与 JSON 版数据形状保持一致，业务层无需改动。
// 启用：npx prisma migrate dev（本地建表） / npx prisma migrate deploy（生产）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipPlan {
  free
  monthly
  yearly
}

enum MembershipStatus {
  active
  expired
  none
}

enum OrderStatus {
  pending
  paid
  closed
}

model User {
  id           String        @id @default(cuid())
  identifier   String        @unique // 手机号或邮箱，登录账号
  passwordHash String?
  nickname     String?
  createdAt    DateTime      @default(now())
  role         String        @default("user") // 'user' | 'admin'
  memberships  Membership[]
  charts       SavedChart[]
  orders       Order[]
}

/// 额度计数：按「身份 id」计数（登录用户 id 或游客 ziwei_guest cookie），
/// 与 User 表解耦，游客同样有持久身份。
/// bonus 为付费赠送的解读次数（如「单次精批」下单成功后发放）。
model Trial {
  identityId String   @id
  used       Int      @default(0)
  bonus      Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model Membership {
  id        String           @id @default(cuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String           @unique
  plan      MembershipPlan   @default(free)
  status    MembershipStatus @default(none)
  startedAt DateTime         @default(now())
  expiresAt DateTime         @default(now())
}

model SavedChart {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  birthInfo Json
  chart     Json
  title     String?
  createdAt DateTime @default(now())
}

model Order {
  id        String      @id @default(cuid())
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  plan      String // 'monthly' | 'yearly' | 'single'
  amount    Int // 单位：分
  status    OrderStatus @default(pending)
  channel   String? // 'wechat' | 'alipay' | 'sandbox'
  createdAt DateTime    @default(now())
  paidAt    DateTime?
}

/// 后台可配置项（试用次数、套餐覆盖等），整体序列化为 JSON 存于 value。
model Setting {
  key       String   @id // 固定为 'app'
  value     String
  updatedAt DateTime @updatedAt
}
