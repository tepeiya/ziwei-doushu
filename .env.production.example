# ─────────────────────────────────────────────────────────────
# 生产环境变量模板：复制为 .env.production 后填入真实值
# 部署命令示例：docker compose --env-file .env.production up -d
# ─────────────────────────────────────────────────────────────

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# NextAuth 回调地址（必须是对外可访问的 HTTPS 域名）
NEXTAUTH_URL=https://your-domain.com

# ⚠️ 生产【必填】。生成：openssl rand -base64 32
# 多实例部署时所有副本必须保持一致，否则登录态失效
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# ─── AI 解读（OpenAI 兼容，二选一）───
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-deepseek-key
# 通用覆盖（任意 OpenAI 兼容端点，设置后优先）：
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-xxxx
# OPENAI_MODEL=gpt-4o-mini

# ─── AI 输出审查中间件（默认开启）───
# 软过滤绝对化措辞 + 硬阻断违规词（诈骗/医疗断言/高危绝对化）+ 免责尾注
# MODERATION_ENABLED=true
# MODERATION_BLOCK_TERMS=加微信,私聊,转账付费,包治百病,必死
# MODERATION_SOFT_TERMS=一定:通常,保证:倾向于,百分百:多数情况下

# ─── 生产数据层（实现 PG 切换后启用，见「部署指南·生产必做改造」）───
# DATABASE_URL=postgresql://ziwei:strongpassword@postgres:5432/ziwei

# ─── 缓存 / 限流（已支持 Redis；docker-compose 含 redis 服务）───
# 启用后：缓存与限流自动切到 Redis（多实例共享、重启不丢），否则回退进程内内存
REDIS_URL=redis://redis:6379

# ─── 支付（微信 / 支付宝真实商户号；留空则走沙箱模拟）───
# WECHAT_MCH_ID=
# WECHAT_API_KEY=
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
