# 复制为 .env.local 后填入实际值

# ─── AI 推理（OpenAI 兼容协议，任选一家）───
# 已实现的 /api/interpret 会读取下面的配置；只想排盘、看命盘的话可以不填。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key

# ─── 或用其他 OpenAI 兼容模型 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 通用覆盖（任意 OpenAI 兼容端点，设置后优先于上面的 provider 默认值）───
# OPENAI_BASE_URL=https://your-endpoint/v1
# OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_MODEL=your-model-name

# ─── AI 输出审查中间件（默认开启）───
# 软过滤绝对化措辞 + 硬阻断违规词（诈骗/医疗断言/高危绝对化）+ 免责尾注
# MODERATION_ENABLED=true
# MODERATION_BLOCK_TERMS=加微信,私聊,转账付费,包治百病,必死
# MODERATION_SOFT_TERMS=一定:通常,保证:倾向于,百分百:多数情况下

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── 鉴权（NextAuth / Auth.js）───
# ⚠️ 生产环境【必须】设置 NEXTAUTH_SECRET，否则登录会报 "server configuration" 错误（500）。
# 本地可临时用：openssl rand -base64 32
# 生产启动会校验：缺失 / 占位值 / 长度<32 将拒绝启动（见 lib/server/secrets.ts）。
NEXTAUTH_SECRET=your-nextauth-secret-change-me
# 部署后的站点对外地址（含协议与端口），用于回调拼接
NEXTAUTH_URL=http://localhost:3000

# ─── 密码哈希强度（可选）───
# scrypt 成本因子 N（2^14~2^18），默认 32768。
# PASSWORD_SCRYPT_COST=32768

# ─── 支付（微信 / 支付宝，接入后 /api/pay/create 会走真实网关）───
# 未配置时自动走「沙箱模拟支付」，便于本地验证会员闭环。
# WECHAT_MCH_ID=your-wechat-merchant-id
# WECHAT_API_KEY=your-wechat-api-key
# ALIPAY_APP_ID=your-alipay-app-id
# ALIPAY_PRIVATE_KEY=your-alipay-private-key
